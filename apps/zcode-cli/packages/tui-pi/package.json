{
  "name": "@zcode/tui-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test": "tsx --disable-warning=DEP0205 --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore",
    "lint:fix": "oxlint --write src --no-ignore"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.3.0",
    "@zcode/contracts": "workspace:*",
    "@zcode/i18n": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/tui": "workspace:*"
  },
  "devDependencies": {
    "@mbears/opentui-core": "0.2.15",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
